                    ]
                  },
                  "city": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "items": {
                    "minItems": 1,
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "productId": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{24}$"
                        },
                        "qty": {
                          "type": "integer",
                          "minimum": 1,
