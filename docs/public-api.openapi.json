    "/api/v1/public/products": {
      "get": {
        "summary": "Active products (filter by category slug, text, type, green, featured, in stock; sort; paginate)",
        "tags": ["Public (website)"],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 170,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 60
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["single", "combo"]
            }
          },
          {
            "name": "green",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["0", "1", "true", "false"]
            }
          },
          {
            "name": "featured",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["0", "1", "true", "false"]
            }
          },
          {
            "name": "inStock",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["0", "1", "true", "false"]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "default": "featured",
              "type": "string",
              "enum": ["featured", "price_asc", "price_desc", "discount", "name", "newest"]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "default": 24,
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
