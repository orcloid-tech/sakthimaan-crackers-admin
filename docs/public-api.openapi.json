{
  "openapi": "3.1.0",
  "info": {
    "title": "Storefront API (/api/v1/public)",
    "version": "0.1.0",
    "description": "Public endpoints for the customer website. Response types: docs/storefront-client.ts. Guide: docs/PUBLIC_API.md."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/public/orders": {
      "post": {
        "summary": "Submit an enquiry / order from the website (captcha header X-Captcha-Token)",
        "tags": ["Public (website)"],
        "description": "Prices come from the catalogue. Checks store open, blocked customers, serviceable location and the minimum order.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "customer": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "maxLength": 120
                      },
                      "phone": {
                        "type": "string"
                      },
                      "altPhone": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      },
                      "gstin": {
                        "type": "string",
                        "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$"
                      }
                    },
                    "required": ["name", "phone"],
                    "additionalProperties": false
                  },
                  "address": {
                    "type": "object",
                    "properties": {
                      "line1": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "line2": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "landmark": {
                        "type": "string",
                        "maxLength": 120
                      },
                      "city": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "district": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "stateCode": {
                        "type": "string",
                        "enum": [
                          "JK",
                          "HP",
                          "PB",
                          "CH",
                          "UK",
                          "HR",
                          "DL",
                          "RJ",
                          "UP",
                          "BR",
                          "SK",
                          "AR",
                          "NL",
                          "MN",
                          "MZ",
                          "TR",
                          "ML",
                          "AS",
                          "WB",
                          "JH",
                          "OD",
                          "CG",
                          "MP",
                          "GJ",
                          "DH",
                          "MH",
                          "KA",
                          "GA",
                          "LD",
                          "KL",
                          "TN",
                          "PY",
                          "AN",
                          "TS",
                          "AP",
                          "LA"
                        ]
                      },
                      "pincode": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{5}$"
                      }
                    },
                    "required": ["line1", "city", "stateCode", "pincode"],
                    "additionalProperties": false
                  },
                  "items": {
                    "minItems": 1,
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "productId": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{24}$"
                        },
                        "qty": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        }
                      },
                      "required": ["productId", "qty"],
                      "additionalProperties": false
                    }
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": ["customer", "address", "items"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                }
              }
            }
          },
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "NOT_SERVICEABLE / BELOW_MIN_ORDER / PRODUCT_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "STORE_CLOSED / INSUFFICIENT_STOCK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/orders/preview": {
      "post": {
