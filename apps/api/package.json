{
  "name": "@sakthimaan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx watch --conditions=source --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "create-super-admin": "tsx --conditions=source --env-file-if-exists=.env src/scripts/create-super-admin.ts",
    "db:indexes": "tsx --conditions=source --env-file-if-exists=.env src/scripts/sync-indexes.ts",
    "db:local": "tsx src/scripts/local-db.ts",
    "templates": "tsx --conditions=source src/scripts/generate-templates.ts",
    "seed": "tsx --conditions=source --env-file-if-exists=.env src/scripts/seed.ts"
  },
  "dependencies": {
    "@sakthimaan/shared": "0.1.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mongoose": "^9.0.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "pdfmake": "^0.3.11",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.0.3"
  }
}
