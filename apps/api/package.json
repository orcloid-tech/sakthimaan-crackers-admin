{
  "name": "@sakthimaan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx watch --conditions=source --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "create-super-admin": "tsx --conditions=source --env-file-if-exists=.env src/scripts/create-super-admin.ts",
    "db:indexes": "tsx --conditions=source --env-file-if-exists=.env src/scripts/sync-indexes.ts",
    "db:local": "tsx src/scripts/local-db.ts"
  },
  "dependencies": {
    "@sakthimaan/shared": "0.1.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mongoose": "^9.0.0",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.0.3"
  }
}
