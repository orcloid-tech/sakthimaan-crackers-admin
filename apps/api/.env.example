# Copy to apps/api/.env for local development. Every variable is validated at startup
# (src/config/env.ts); the API refuses to start with a list of what is wrong.
# Never commit real secrets.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Number of reverse proxies in front of the API (Render/Railway/Nginx: 1). 0 locally.
TRUST_PROXY=0

# Must be a replica set (transactions). Recommended: the Atlas dev cluster (mongodb+srv://...).
# Offline fallback: `npm run db:local -w @sakthimaan/api`, then use the URI below.
MONGODB_URI=mongodb://127.0.0.1:27017/sakthimaan?replicaSet=rs0&directConnection=true

# Comma-separated full origins.
CORS_ADMIN_ORIGINS=http://localhost:5173
CORS_PUBLIC_ORIGINS=http://localhost:3000
ADMIN_APP_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# A rotated refresh token re-presented within this window (two tabs, retried request)
# gets the same new pair instead of logging the user out everywhere. 0 disables.
REFRESH_REUSE_GRACE_SECONDS=30

# Refresh cookie. Production: admin.<domain> + api.<domain> (same site), so keep strict.
# Default hosting domains (*.onrender.com, *.vercel.app) break the cookie: see README.
COOKIE_SAMESITE=strict
# Defaults to true in production (required there).
# COOKIE_SECURE=false
# Leave unset (host-only cookie on the API host; safest). Set e.g. example.com only if
# another subdomain must receive the cookie.
# COOKIE_DOMAIN=

BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

RATE_LIMIT_ADMIN_PER_MIN=600
RATE_LIMIT_AUTH_PER_15MIN=20
RATE_LIMIT_PUBLIC_READ_PER_MIN=120
RATE_LIMIT_PUBLIC_WRITE_PER_10MIN=10

# console (logs emails, dev only) | smtp (any SMTP server; required in production)
MAIL_PROVIDER=console
MAIL_FROM="Sakthimaan Crackers <no-reply@example.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Captcha for public write endpoints: only "none" for now (hook in place).
CAPTCHA_PROVIDER=none

# Swagger UI at /api/docs. Defaults: on outside production, off in production.
# API_DOCS_ENABLED=true
JSON_BODY_LIMIT=1mb

# First Super Admin (used only by `npm run create-super-admin -w @sakthimaan/api`).
# SUPERADMIN_EMAIL=owner@example.com
# SUPERADMIN_NAME=Owner
# SUPERADMIN_PASSWORD=
